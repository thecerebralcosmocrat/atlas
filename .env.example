# These environment values are fallbacks. The Settings page can set the key,
# models, and endpoints for packaged builds, and a saved setting wins over the
# value here. Settings are stored per device in the app's data folder.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Embeddings are optional: without a key, indexing and answers still work and
# retrieval falls back to lexical ranking.
NVIDIA_NIM_EMBED_MODEL=nvidia/nemotron-3-embed-1b
# NVIDIA_NIM_EMBED_API_URL=https://integrate.api.nvidia.com/v1/embeddings
